# Configuración del servidor
PORT=5000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=project_manager

# JWT
JWT_SECRET=tu_clave_secreta_muy_segura_cambia_esto_en_produccion
JWT_EXPIRES_IN=12h

# Proxies delante del backend (Railway, Nginx). 1 = uno; 0 = ninguno.
# Lo usa el límite de intentos para saber la IP real de cada usuario.
TRUST_PROXY=1

# Correo de notificaciones (Gmail con OAuth)
# Cliente OAuth "Aplicación web" creado en el proyecto de Google Cloud.
# Se puede pegar el JSON completo que descarga Google...
GOOGLE_OAUTH_CLIENT_JSON={"web":{"client_id":"...apps.googleusercontent.com","client_secret":"..."}}
# ...o, en su lugar, los dos valores sueltos:
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# Debe coincidir EXACTAMENTE con un URI autorizado en el cliente OAuth
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/settings/email/oauth/callback
# Clave para cifrar el token de la cuenta conectada (64 caracteres hex).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# La cuenta que envía (y el nombre del remitente) se configura desde la
# aplicación: Administración → Correo del sistema. Las antiguas variables
# EMAIL_HOST/PORT/USER/PASS ya no se usan.

# Frontend URL (para CORS y links en emails)
FRONTEND_URL=http://localhost:5173

# Archivos adjuntos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Google Drive — Unidad Compartida para los adjuntos
# Los dos primeros salen del JSON de la cuenta de servicio (Google Cloud).
# La clave privada va entre comillas y con los saltos de linea como \n.
# El ID de la unidad es la ultima parte de su URL en Drive.
GDRIVE_CLIENT_EMAIL=projectflow-drive@tu-proyecto.iam.gserviceaccount.com
GDRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GDRIVE_SHARED_DRIVE_ID=0ABxxxxxxxxxxxxUk9PVA

# Nombres de las dos carpetas principales dentro de la unidad.
# Opcionales: si no se definen, se usan "Documentos" y "SGC".
# Dentro de cada una se crea una carpeta por proyecto.
GDRIVE_FOLDER_DOCUMENTOS=Documentos
GDRIVE_FOLDER_SGC=SGC
